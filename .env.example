PORT=3000
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha

# Onde fica o banco de dados. Na hospedagem use uma pasta FORA da pasta do app,
# senão os dados somem a cada nova implantação. "~" = pasta pessoal do usuário no servidor.
# DATA_DIR=~/credenciamento-data

# Integração Mautic (opcional — também pode ser configurada pela tela "Integração Mautic").
# Com estas variáveis a integração volta configurada sozinha mesmo com o banco vazio.
# MAUTIC_URL=https://mkt.maiscorporativo.tur.br
# MAUTIC_USER=
# MAUTIC_PASS=
# MAUTIC_FORMS=33:VISITANTE,32:EXPOSITOR,40:EXPOSITOR
# MAUTIC_POLL=1
# MAUTIC_WEBHOOK_SECRET=
